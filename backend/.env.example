# Copy to backend/.env and adjust. Never commit real secrets.
# Relative DATA_DIR paths resolve against backend/.

# SQLite only (ADR-002). Default: backend/traceva.db
DATABASE_URL=sqlite:///./traceva.db
# Default: <repo>/datasets
DATA_DIR=../datasets
# Cap on rows/groups returned by analytical tools (1-500)
MAX_TOOL_RESULT_ROWS=30

# --- LLM (OpenAI-compatible endpoint; Ollama by default) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
# Derived model with num_ctx pinned; create it from ollama/traceva-qwen3.5-4b-8k.Modelfile
LLM_MODEL=traceva-qwen3.5-4b-8k
# Ollama ignores the key; hosted providers need a real one (never commit it)
LLM_API_KEY=ollama
LLM_TEMPERATURE=0
# false sends reasoning_effort=none; reasoning text is always discarded, never stored
LLM_THINKING=false
# LLM_SEED=7
LLM_TIMEOUT_S=300
LLM_MAX_RETRIES=2
# Must match the model's num_ctx; the run fails with CONTEXT_EXHAUSTED near this limit.
# Set to none to disable the guard (e.g. hosted models with very large windows).
LLM_CONTEXT_TOKENS=8192
LLM_OUTPUT_RESERVE_TOKENS=1024

# --- Agent budgets ---
MAX_AGENT_STEPS=8
MAX_RUN_SECONDS=900
MAX_TOOL_CALLS_PER_STEP=4
MAX_TOOL_RESULT_CHARS=6000
# API: runs executed in parallel (a local CPU model gains little from more than 1-2)
MAX_CONCURRENT_RUNS=1
